# syntax=docker/dockerfile:1

FROM golang:1.24@sha256:d2d2bc1c84f7e60d7d2438a3836ae7d0c847f4888464e7ec9ba3a1339a1ee804 AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/result-api ./cmd/result-api
COPY internal/reliability ./internal/reliability
COPY internal/results ./internal/results
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /result-api ./cmd/result-api

FROM gcr.io/distroless/static:nonroot@sha256:f7f8f729987ad0fdf6b05eeeae94b26e6a0f613bdf46feea7fc40f7bd72953e6
COPY --from=builder /result-api /result-api
USER 65532:65532
ENTRYPOINT ["/result-api"]
