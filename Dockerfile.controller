FROM golang:1.24 AS builder
WORKDIR /workspace
COPY go.mod go.sum* ./
RUN go mod download
COPY api api
COPY cmd cmd
COPY internal internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /agentstorm-controller ./cmd/controller

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /agentstorm-controller /agentstorm-controller
USER 65532:65532
ENTRYPOINT ["/agentstorm-controller"]
